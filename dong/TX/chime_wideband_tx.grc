options:
  parameters:
    author: oyc
    catch_exceptions: 'True'
    category: '[Dong]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Low-rate Chime-style LFM upchirp transmitter using a repeated fc32
      waveform file
    gen_cmake: 'Off'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: chime_wideband_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Chime Wideband TX
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1176, 96.0]
    rotation: 0
    state: enabled

blocks:
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: '487700000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 24]
    rotation: 0
    state: enabled
- name: rf_bandwidth
  id: variable
  parameters:
    comment: ''
    value: '2000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 24]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '2000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 24]
    rotation: 0
    state: enabled
- name: tx_device_addr
  id: variable
  parameters:
    comment: Change this if the TX USRP is the other radio.
    value: '"serial=2512552"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 120]
    rotation: 0
    state: enabled
- name: tx_gain_db
  id: variable
  parameters:
    comment: Absolute B210 TX gain in dB.
    value: '100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 24]
    rotation: 0
    state: enabled
- name: tx_samples
  id: variable
  parameters:
    comment: ''
    value: int(samp_rate * tx_seconds)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 216]
    rotation: 0
    state: enabled
- name: tx_seconds
  id: variable
  parameters:
    comment: Flowgraph stops after this many seconds.
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 84.0]
    rotation: 0
    state: enabled
- name: waveform_file
  id: variable
  parameters:
    comment: One 20 ms fc32 chirp period generated by chime_wideband_make_tx_waveform.py.
    value: r"D:\Desktop\fingerprint_localization\dong\inputs\chime_test_tx_period_fc32.bin"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 120]
    rotation: 0
    state: enabled
- name: blocks_complex_to_mag_0
  id: blocks_complex_to_mag
  parameters:
    affinity: ''
    alias: ''
    comment: "\u628A\u9001\u5F80 USRP Sink \u7684\u590D\u6570 IQ \u8F6C\u6210\u5E45\
      \u5EA6\u5305\u7EDC\uFF0C\u7528\u6765\u786E\u8BA4 TX \u6A21\u677F\u786E\u5B9E\
      \u5728\u6D41\u52A8\u3002"
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 488]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: Repeats one chirp period from disk/cache.
    file: waveform_file
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'True'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 336.0]
    rotation: 0
    state: enabled
- name: blocks_head_0
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: tx_samples
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 376]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'True'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: "\u5B9E\u65F6\u89C2\u5BDF TX \u5E45\u5EA6\u5305\u7EDC\uFF1B\u63A5\u5728\
      \ Head \u540E\u9762\uFF0C\u6240\u4EE5\u5B83\u663E\u793A\u7684\u5C31\u662F\u672C\
      \u6B21\u9001\u5165 USRP Sink \u7684\u6837\u672C\u3002"
    ctrlpanel: 'True'
    entags: 'True'
    grid: 'True'
    gui_hint: ''
    label1: TX |IQ| envelope
    label10: Signal 10
    label2: Signal 2
    label3: Signal 3
    label4: Signal 4
    label5: Signal 5
    label6: Signal 6
    label7: Signal 7
    label8: Signal 8
    label9: Signal 9
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: TX Time Amplitude
    nconnections: '1'
    size: int(samp_rate * 0.025)
    srate: samp_rate
    stemplot: 'False'
    style1: '1'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: Amplitude
    ymax: '0.3'
    ymin: '0'
    yunit: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1104, 388.0]
    rotation: 0
    state: enabled

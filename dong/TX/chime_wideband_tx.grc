options:
  parameters:
    author: guang
    catch_exceptions: 'True'
    category: '[Dong]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Low-rate Chime-style LFM upchirp transmitter using a repeated fc32 waveform file
    gen_cmake: 'Off'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: chime_wideband_tx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Chime Wideband TX
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '2000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 24]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: '487700000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 24]
    rotation: 0
    state: enabled
- name: rf_bandwidth
  id: variable
  parameters:
    comment: ''
    value: '2000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 24]
    rotation: 0
    state: enabled
- name: tx_gain_db
  id: variable
  parameters:
    comment: Absolute B210 TX gain in dB.
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 24]
    rotation: 0
    state: enabled
- name: tx_device_addr
  id: variable
  parameters:
    comment: Change this if the TX USRP is the other radio.
    value: '"serial=2512552"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 120]
    rotation: 0
    state: enabled
- name: waveform_file
  id: variable
  parameters:
    comment: One 20 ms fc32 chirp period generated by chime_wideband_make_tx_waveform.py.
    value: r"dong\inputs\chime_test_tx_period_fc32.bin"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 120]
    rotation: 0
    state: enabled
- name: tx_seconds
  id: variable
  parameters:
    comment: Flowgraph stops after this many seconds.
    value: '10'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 120]
    rotation: 0
    state: enabled
- name: tx_samples
  id: variable
  parameters:
    comment: ''
    value: int(samp_rate * tx_seconds)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 216]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: Repeats one chirp period from disk/cache.
    file: waveform_file
    length: '0'
    offset: '0'
    repeat: 'True'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 360]
    rotation: 0
    state: enabled
- name: blocks_head_0
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    num_items: tx_samples
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 376]
    rotation: 0
    state: enabled
- name: uhd_usrp_sink_0
  id: uhd_usrp_sink
  parameters:
    affinity: ''
    alias: ''
    ant0: '"TX/RX"'
    bw0: rf_bandwidth
    center_freq0: center_freq
    clock_rate: 0e0
    clock_source0: internal
    comment: ''
    dev_addr: tx_device_addr
    dev_args: '""'
    gain0: tx_gain_db
    gain_type0: default
    len_tag_name: '""'
    nchan: '1'
    num_mboards: '1'
    otw: sc16
    samp_rate: samp_rate
    show_lo_controls: 'False'
    stream_args: '""'
    stream_chans: '[]'
    sync: pc_clock
    time_source0: ''
    type: fc32
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [744, 352]
    rotation: 0
    state: enabled

connections:
- [blocks_file_source_0, '0', blocks_head_0, '0']
- [blocks_head_0, '0', uhd_usrp_sink_0, '0']

metadata:
  file_format: 1

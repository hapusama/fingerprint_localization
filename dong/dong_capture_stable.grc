options:
  parameters:
    author: guang
    catch_exceptions: 'True'
    category: '[Dong]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Stable no-GUI USRP B210 IQ capture for high sample rates
    gen_cmake: 'Off'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: dong_capture_stable
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Dong Stable Capture
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: Use 500000 for LoRa decoding; use 20000000 only for wideband tests.
    value: '20000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 24]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: '487700000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 24]
    rotation: 0
    state: enabled
- name: rf_bandwidth
  id: variable
  parameters:
    comment: Match this to the analog bandwidth you need.
    value: '10000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 24]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable
  parameters:
    comment: Normalized RX gain.
    value: '0.6'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 24]
    rotation: 0
    state: enabled
- name: capture_seconds
  id: variable
  parameters:
    comment: Finite capture length. 20 MS/s fc32 is about 160 MB/s.
    value: '5'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 128]
    rotation: 0
    state: enabled
- name: capture_samples
  id: variable
  parameters:
    comment: ''
    value: int(samp_rate * capture_seconds)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 128]
    rotation: 0
    state: enabled
- name: device_addr
  id: variable
  parameters:
    comment: Leave empty to auto-select the only attached USRP, or set "serial=xxxx".
    value: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 128]
    rotation: 0
    state: enabled
- name: output_file
  id: variable
  parameters:
    comment: Output is GNU Radio complex64/fc32 IQ.
    value: r"dong\outputs\captures\stable_capture_fc32.bin"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 128]
    rotation: 0
    state: enabled
- name: uhd_usrp_source_0
  id: uhd_usrp_source
  parameters:
    affinity: ''
    alias: ''
    ant0: '"TX/RX"'
    bw0: rf_bandwidth
    center_freq0: center_freq
    clock_rate: 0e0
    clock_source0: internal
    comment: ''
    dc_offs0: 0+0j
    dc_offs_enb0: default
    dev_addr: device_addr
    dev_args: '""'
    gain0: rx_gain
    gain_type0: normalized
    iq_imbal0: 0+0j
    iq_imbal_enb0: default
    lo_export0: 'False'
    lo_source0: internal
    nchan: '1'
    num_mboards: '1'
    otw: sc16
    rx_agc0: Disabled
    samp_rate: samp_rate
    show_lo_controls: 'False'
    start_time: '-1.0'
    stream_args: '""'
    stream_chans: '[]'
    sync: pc_clock
    time_source0: ''
    type: fc32
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [224, 320]
    rotation: 0
    state: enabled
- name: blocks_head_0
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    num_items: capture_samples
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 344]
    rotation: 0
    state: enabled
- name: blocks_file_sink_0
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: Buffered file sink. Keep unbuffered off for high-rate capture.
    file: output_file
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 344]
    rotation: 0
    state: enabled

connections:
- [uhd_usrp_source_0, '0', blocks_head_0, '0']
- [blocks_head_0, '0', blocks_file_sink_0, '0']

metadata:
  file_format: 1
